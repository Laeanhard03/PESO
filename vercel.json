{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bash scripts/vercel_install_flutter.sh",
  "buildCommand": "bash scripts/vercel_build_flutter.sh",
  "outputDirectory": "build/web",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "backend/mini_ai_runtime/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/nsrp",
      "destination": "/nsrp/index.html"
    },
    {
      "source": "/nsrp/:match*",
      "destination": "/nsrp/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
