rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every account is stored at users/{Firebase Auth UID}. A signed-in user
    // can read/update only their own profile and may never change its UID/role.
    match /users/{userId} {
      function ownsProfile() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow create: if ownsProfile()
        && request.resource.data.uid == userId
        && request.resource.data.role == 'job_seeker';

      allow read: if ownsProfile()
        || (request.auth != null && request.auth.token.admin == true);

      allow update: if ownsProfile()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;

      allow delete: if false;

      match /{nestedDocument=**} {
        allow read, write: if ownsProfile();
      }
    }

    // Deny all collections that have not been intentionally opened above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
