# Copy to .env.compose (ignored by Git) and use for local Docker Compose only.
# Generate unique random alphanumeric values of at least 32 characters for both passwords.
# Do not reuse production credentials.
PESO_MONGO_ROOT_USER=peso_local_root
PESO_MONGO_ROOT_PASSWORD=REPLACE_WITH_32_OR_MORE_RANDOM_ALPHANUMERIC_CHARACTERS
PESO_MONGO_USER=peso_local
PESO_MONGO_APP_PASSWORD=REPLACE_WITH_DIFFERENT_32_OR_MORE_RANDOM_ALPHANUMERIC_CHARACTERS
FIREBASE_SERVICE_ACCOUNT_FILE=./backend/service-account.json
FIREBASE_PROJECT_ID=capstone-4th-year-peso-ai
INITIAL_ADMIN_EMAIL=admin@example.invalid
GEMINI_API_KEY=
GEMINI_KEY_ENCRYPTION_SECRET=
GEMINI_MODEL=gemini-3.8-flash
FILE_LINK_SECRET=replace_with_a_unique_random_local_secret
PESO_EXPORT_SECRET=replace_with_a_different_unique_random_local_secret