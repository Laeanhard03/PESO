# Gmail SMTP template for PESO Excel report email. Copy values to your private environment.
# Do not put actual credentials in this example file or commit a real .env.
PESO_SMTP_HOST=smtp.gmail.com
PESO_SMTP_PORT=465
PESO_SMTP_SECURE=true
PESO_SMTP_USER=your-account@gmail.com
PESO_SMTP_PASS=replace-with-google-app-password
PESO_SMTP_FROM=your-account@gmail.com
PESO_REPORT_EMAIL=
