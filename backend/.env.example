# Example backend environment. Copy to .env and fill local values; never commit .env.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
FIREBASE_PROJECT_ID=capstone-4th-year-peso-ai

# Firebase Admin account deletion requires Admin SDK credentials for this project.
# Set GOOGLE_APPLICATION_CREDENTIALS to a protected service-account JSON file path,
# or use Application Default Credentials/workload identity in the deployment environment.
# Never commit or print the service-account file or private key.
INITIAL_ADMIN_EMAIL=ferrerajoshlander@gmail.com

# Replace with a dedicated app database user's URI, restricted to readWrite on peso_jobkonek.
# URL-encode special characters in the username/password if necessary.
MONGODB_URI=mongodb+srv://DB_USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER_HOST/peso_jobkonek?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=peso_jobkonek

# Optional: only needed for AI resume/profile extraction, not Admin or MongoDB profiles.
GEMINI_API_KEY=
# Required for managed Gemini API keys in the Admin editor: base64 of exactly 32 random bytes.
# The secure setup helper generates/preserves this value; never rotate it while encrypted keys exist.
GEMINI_KEY_ENCRYPTION_SECRET=
GEMINI_MODEL=gemini-3.8-flash

# The local setup script generates a random secret for short-lived file links.
FILE_LINK_SECRET=
PUBLIC_API_BASE_URL=http://localhost:3000
# Optional; configure a unique 32+-character value for portable signed Excel/resume links.
# Without it, a secure process-local key is generated (links expire on API restart).
PESO_EXPORT_SECRET=
# Optional comma-separated public hostnames that can supply HTTPS recruitment PDFs.
# Government .gov.ph HTTPS PDF links are permitted without additional hosts.
PESO_PDF_ALLOWED_HOSTS=

# Exact local Flutter web origins. The development API also permits localhost/127.0.0.1.
CLIENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
